{
  "name": "{{project-name}}",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc --noEmit && bun build ./src/index.ts --target=bun --outdir=dist --sourcemap=linked",
    "start": "NODE_ENV=production bun run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "hono": "4.13.10"
  },
  "devDependencies": {
    "@hono/eslint-config": "2.1.1",
    "@types/bun": "1.4.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}

{
  "name": "@nocdn/chat-export",
  "version": "0.0.1",
  "description": "A npx-runnable CLI to export a chat from either opencode or codex into plain text, to take elsewhere",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "chat-export": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6"
  }
}

{
  "name": "@nocdn/chat-export",
  "version": "0.0.2",
  "description": "Search and export a local Codex or OpenCode chat as text, Markdown, or JSON",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocdn/chat-export.git"
  },
  "keywords": [
    "codex",
    "opencode",
    "chat",
    "export",
    "transcript",
    "cli",
    "nocdn"
  ],
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "bin": {
    "chat-export": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "@inquirer/core": "12.0.3",
    "@inquirer/select": "5.2.5",
    "fzf": "0.5.2"
  }
}
